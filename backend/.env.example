# Application
PORT=3000
NODE_ENV=development

# Database (PostgreSQL via Prisma)
DATABASE_URL=postgresql://mediflow:mediflow_password@localhost:5433/mediflow_db?schema=public

# Security & Authentication
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters-without-dollar-signs
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7
OTP_PEPPER=replace-with-a-random-otp-pepper-of-at-least-32-characters-without-dollar-signs

# Production only: HTTPS JSON endpoint accepting { recipient, code, purpose }
OTP_DELIVERY_URL=https://otp-provider.example/v1/send
OTP_DELIVERY_TOKEN=replace-with-provider-bearer-token

# Development seed only. Set a different password (at least 12 characters) for each account.
SEED_ADMIN_PASSWORD=replace-with-unique-admin-development-password
SEED_RECEPTIONIST_PASSWORD=replace-with-unique-receptionist-development-password
SEED_DOCTOR_ABEBE_PASSWORD=replace-with-unique-doctor-abebe-development-password
SEED_DOCTOR_HANA_PASSWORD=replace-with-unique-doctor-hana-development-password
SEED_PATIENT_AYALEW_PASSWORD=replace-with-unique-patient-ayalew-development-password
SEED_PATIENT_MEKDES_PASSWORD=replace-with-unique-patient-mekdes-development-password
SEED_PATIENT_DAWIT_PASSWORD=replace-with-unique-patient-dawit-development-password

# CORS
CORS_ORIGIN=http://localhost:5173
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
TRUST_PROXY_HOPS=0

# API Configuration
API_PREFIX=api/v1
SWAGGER_PATH=api/docs
SWAGGER_ENABLED=true
